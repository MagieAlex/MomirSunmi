<?xml version="1.0" encoding="utf-8"?>
<!--
  The art window. Paper-coloured, because what goes in it is a 1-bit dither
  meant to be read as ink on a slip - shown on the near-black screen it would be
  a photographic negative of itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/paper" />
    <corners android:radius="3dp" />
    <stroke android:width="1dp" android:color="@color/accent_dim" />
</shape>
