<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected row: gold hairline and a whisper of gold behind it. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_ghost" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33C9A85C">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_sunken" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
