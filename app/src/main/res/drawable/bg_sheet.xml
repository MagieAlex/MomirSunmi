<?xml version="1.0" encoding="utf-8"?>
<!--
  The token sheet's own frame. Double-ruled like a card border: dark panel, gold
  hairline. Rounded at the top only - it rises from the bottom edge and stays
  attached to it, so a radius at the foot would be a corner of nothing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/surface_raised"
        android:endColor="@color/surface" />
    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke android:width="1dp" android:color="@color/accent_dim" />
</shape>
