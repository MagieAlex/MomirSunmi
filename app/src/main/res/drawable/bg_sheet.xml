<?xml version="1.0" encoding="utf-8"?>
<!-- The token sheet's own frame. Double-ruled like a card border: dark panel, gold hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/surface_raised"
        android:endColor="@color/surface" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/accent_dim" />
</shape>
