<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:keepScreenOn="true">

    <!-- header -->

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.Momir.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:text="@string/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The printer's state, as a lamp beside the wordmark.

      The AIDL service can go away underneath a running app, and until this was
      here the first anyone knew of it was a print that did nothing. It is 8 dp
      because it is not news most of the time.
    -->
    <View
        android:id="@+id/printerDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_dot"
        android:contentDescription="@string/printer_state"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintStart_toEndOf="@id/title"
        app:layout_constraintTop_toTopOf="@id/title" />

    <ImageButton
        android:id="@+id/scanButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/scan"
        android:src="@drawable/ic_scan"
        app:layout_constraintBottom_toBottomOf="@id/settingsButton"
        app:layout_constraintEnd_toStartOf="@id/syncButton"
        app:layout_constraintTop_toTopOf="@id/settingsButton" />

    <ImageButton
        android:id="@+id/syncButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/resync"
        android:src="@drawable/ic_sync"
        app:layout_constraintBottom_toBottomOf="@id/settingsButton"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="@id/settingsButton" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/headerRule"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsButton" />

    <!-- what the dial rolls -->

    <!--
      Six chips are about twice the width of a 360 dp screen, so the row scrolls.
      The fading edge is what admits that: a chip dissolving at the screen edge
      reads as more to come, where a row stopping flush reads as all there is.
      Padding rather than margins, unclipped, so a chip fades under the edge
      instead of stopping short of it.
    -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:fadingEdgeLength="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRule">

        <LinearLayout
            android:id="@+id/categoryRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- mana value dial -->

    <software.zeasy.momir.ui.ManaWheel
        android:id="@+id/manaWheel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/countLabel"
        app:layout_constraintHeight_min="180dp"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll" />

    <TextView
        android:id="@+id/countLabel"
        style="@style/TextAppearance.Momir.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/printButton"
        tools:text="4,301 creatures at mana value 3" />

    <!-- the big button -->

    <software.zeasy.momir.ui.PrintButton
        android:id="@+id/printButton"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@id/resultCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- last result -->

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_result"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <!--
          The colour-identity stripe. A card's frame tells you its colours before
          you have read a word of it; this is the same trick in 4 dp.
        -->
        <View
            android:id="@+id/resultStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:minHeight="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultName"
                style="@style/TextAppearance.Momir.CardName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Thragtusk" />

            <TextView
                android:id="@+id/resultDetail"
                style="@style/TextAppearance.Momir.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Creature — Beast · 5/3 · 88 mm" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultTokens"
            style="@style/TextAppearance.Momir.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:text="2 tokens"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- empty state -->

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll">

        <TextView
            style="@style/TextAppearance.Momir.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_corpus_title" />

        <TextView
            style="@style/TextAppearance.Momir.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="@string/no_corpus_body" />
    </LinearLayout>

    <!--
      Last child, so it draws over everything. Not clickable, so touches fall
      straight through to the dial and the button underneath.
    -->
    <software.zeasy.momir.ui.GlowOverlay
        android:id="@+id/glowOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
