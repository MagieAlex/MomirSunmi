<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_viewfinder" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Momir.Body"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:text="@string/scan_hint" />

    <!--
      A TextView, for the reason documented in dialog_settings.xml: under a
      MaterialComponents theme a <Button> is inflated as a MaterialButton, which
      brings its own background and ignores the borderless style it was given.
      This one was the last place in the app still carrying that bug.
    -->
    <TextView
        android:id="@+id/closeButton"
        style="@style/TextAppearance.Momir.Action"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_ghost"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/close"
        android:textColor="@color/text_primary" />

</FrameLayout>
