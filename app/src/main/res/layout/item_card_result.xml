<?xml version="1.0" encoding="utf-8"?>
<!--
  One search hit. Mana value in its ring, name, type line - the three things you
  need to know you have found the right card, in the order the slip prints them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/resultBadge"
        style="@style/TextAppearance.Momir.CardName"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:textColor="@color/accent_soft"
        tools:text="7" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/resultCardName"
            style="@style/TextAppearance.Momir.CardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Urza, Planeswalker" />

        <TextView
            android:id="@+id/resultCardType"
            style="@style/TextAppearance.Momir.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Legendary Planeswalker — Urza" />
    </LinearLayout>

</LinearLayout>
